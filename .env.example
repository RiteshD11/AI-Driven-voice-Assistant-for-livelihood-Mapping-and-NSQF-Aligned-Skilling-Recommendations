# ============================================
# Unnati - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/unnati

# ---- Backend ----
PORT=5000
JWT_SECRET=riteshsecretkeyfortokens
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ---- AI Service ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ---- Optional: LLM API (leave empty for demo mode) ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Optional: Speech API (leave empty for Web Speech API / demo mode) ----
BHASHINI_API_KEY=

# ---- Demo Mode ----
DEMO_MODE=true



